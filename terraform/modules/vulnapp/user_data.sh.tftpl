#!/bin/bash
# endpoints: ${depends_marker}
# vulnapp のセットアップ。EC2 初回起動時に root で実行される。
set -euxo pipefail

dnf install -y python3 python3-pip

# アプリ専用の一般ユーザー。root で Web アプリを動かさない
id vulnapp >/dev/null 2>&1 || useradd --system --home-dir /opt/vulnapp --shell /sbin/nologin vulnapp
mkdir -p /opt/vulnapp /var/lib/vulnapp/files

cat > /opt/vulnapp/app.py <<'PYEOF'
${app_py}
PYEOF

# 依存は S3 に置いた wheel からオフラインで入れる(インターネットへの経路がなくても動く)。
# バージョンは固定(サプライチェーン対策の最低限)
mkdir -p /tmp/wheels
aws s3 cp --recursive "s3://${artifacts_bucket}/wheels/" /tmp/wheels/
python3 -m venv /opt/vulnapp/venv
/opt/vulnapp/venv/bin/pip install --no-cache-dir --disable-pip-version-check \
  --no-index --find-links /tmp/wheels flask==3.1.1 gunicorn==23.0.0

chown -R vulnapp:vulnapp /opt/vulnapp /var/lib/vulnapp

cat > /etc/systemd/system/vulnapp.service <<'UNITEOF'
[Unit]
Description=vulnapp (intentionally vulnerable lab app - private VPC only)
After=network-online.target
Wants=network-online.target

[Service]
User=vulnapp
Group=vulnapp
WorkingDirectory=/opt/vulnapp
Environment=VULNAPP_DB=/var/lib/vulnapp/app.db
Environment=VULNAPP_FILES=/var/lib/vulnapp/files
Environment=VULNAPP_VERIFY_TOKEN=${verify_token}
ExecStart=/opt/vulnapp/venv/bin/gunicorn --workers 4 --bind 0.0.0.0:80 --access-logfile - app:app
# 一般ユーザーのまま 80 番で待ち受けるための権限だけを与える
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
UNITEOF

systemctl daemon-reload
systemctl enable --now vulnapp
